@@ -31788,10 +31788,7 @@ void js_parse_init(LEPUSContext *ctx, JSParseState *s, const char *input,
   memset(s, 0, sizeof(*s));
   s->ctx = ctx;
   s->filename = filename;
-  if (GetSettingsWithKey(primjs::kFastParserLookaheadSetting)) {
-    s->experimental_lookahead =
-        primjs::kSkipWrappedExpression | primjs::kUseTokenKinds;
