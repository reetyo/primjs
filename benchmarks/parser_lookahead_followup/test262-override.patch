diff --git a/src/interpreter/quickjs/source/primjs_monitor.cc b/src/interpreter/quickjs/source/primjs_monitor.cc
index e2e398a..a3713b4 100644
--- a/src/interpreter/quickjs/source/primjs_monitor.cc
+++ b/src/interpreter/quickjs/source/primjs_monitor.cc
@@ -4,6 +4,8 @@
 
 #include "quickjs/include/primjs_monitor.h"
 
+#include <cstdlib>
+
 __attribute__((weak)) void MonitorEvent(const char*, const char*, const char*,
                                         const char*) {}
 // Always provide the weak stub regardless of ENABLE_WASM_PERF_COMPARE on this
@@ -15,5 +17,10 @@ __attribute__((weak)) void MonitorEvent(const char*, const char*, const char*,
 __attribute__((weak)) void MonitorDuration(const char*, const char*,
                                            const char*, double) {}
 
-__attribute__((weak)) int GetSettingsFlag() { return 0; }
+__attribute__((weak)) int GetSettingsFlag() {
+  const char* mode = std::getenv("PRIMJS_BENCH_LOOKAHEAD");
+  return mode && mode[0] >= '0' && mode[0] <= '3' && mode[1] == '\0'
+             ? mode[0] - '0'
+             : 0;
+}
 __attribute__((weak)) bool GetSettingsWithKey(const char* key) { return false; }
diff --git a/src/interpreter/quickjs/source/quickjs.cc b/src/interpreter/quickjs/source/quickjs.cc
